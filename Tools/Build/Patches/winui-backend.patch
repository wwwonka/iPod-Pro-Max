+    /// Calls the window's resize handler with its real size when it differs from `expected`, once
+    /// the current update is over.
+    private func reportActualSize(of window: Window, ifNot expected: SIMD2<Int>?) {
+        let actual = size(ofWindow: window)
+        // Within a pixel is the same size: the round trip through the scale factor rounds.
+        if let expected, abs(actual.x - expected.x) <= 1, abs(actual.y - expected.y) <= 1 { return }
+        _ = try? window.dispatcherQueue.tryEnqueue(.normal) {
