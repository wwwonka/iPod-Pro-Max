SwiftCrossUI, to propose upstream: native views (NSViewRepresentable, GtkWidgetRepresentable,
WinUIElementRepresentable) were updated with the view value they were created with, never with
the current one, so they kept their first values forever: a table created empty never got its
rows, and a filtered list never changed. Each layout now stores the current view first.

diff --git a/Sources/AppKitBackend/NSViewRepresentable.swift b/Sources/AppKitBackend/NSViewRepresentable.swift
index 724dd5f7..8c2d7dfb 100644
--- a/Sources/AppKitBackend/NSViewRepresentable.swift
+++ b/Sources/AppKitBackend/NSViewRepresentable.swift
@@ -150,6 +150,9 @@ extension View where Self: NSViewRepresentable {
         backend: Backend
     ) -> ViewLayoutResult {
         let representingWidget = widget as! RepresentingWidget<Self>
+        // Update with this view, not the one the widget was created with: otherwise the native
+        // view keeps receiving its first values (stale rows, labels...).
+        representingWidget.representable = self
         representingWidget.update(with: environment)
 
         let size = representingWidget.representable.sizeThatFits(
